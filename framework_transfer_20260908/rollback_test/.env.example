HOST=127.0.0.1
PORT=5051
DEBUG=0
DATASET_PATH=data/processed/case_items.json
FRONTEND_DIR=frontend/dist/client

# Optional OpenAI-compatible chat completion API.
# DeepSeek Flash example:
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash
# AI_TIMEOUT=60
# AI_FIRST_TOKEN_TIMEOUT=8
# AI_FIRST_TOKEN_MAX_ATTEMPTS=2
# AI_MAX_CONTEXT_CHARS=5200
# AI_API_KEY=

# Optional continuous browser voice (Xunfei streaming ASR)
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
# Optional SLM resource id for the Xunfei ASR endpoint.
XF_ASR_RES_ID=

# Edge TTS output (used by /api/tts)
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=-2%
TTS_PITCH=+0Hz

# Optional OpenAI-compatible embedding API.
# Build index with: python .\scripts\maintenance\rebuild_embedding_index.py --no-resume
EMBEDDING_BASE_URL=https://api.vectorengine.ai/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=64
EMBEDDING_WORKERS=6
EMBEDDING_REQUEST_TIMEOUT=5
EMBEDDING_MAX_RETRIES=4
EMBEDDING_RETRY_BACKOFF=3
EMBEDDING_REQUEST_DELAY=0
EMBEDDING_INDEX_PATH=data/embeddings/case_embeddings.json
EMBEDDING_TEXT_MAX_CHARS=1400
EMBEDDING_MIN_SCORE=0.15
SEARCH_USE_EMBEDDING=0
EMBEDDING_API_KEY=
