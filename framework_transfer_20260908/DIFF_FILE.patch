+
+    @property
+    def detected_language(self) -> str:
+        return self._stream.detected_language
+
+    @property
+    def candidates(self) -> tuple[str, ...]:
+        return self._stream.candidates
+
+
+__all__ = ["AutoXfyunStream", "VoiceProviderError", "XfyunStream"]

